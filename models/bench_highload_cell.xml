<?xml version="1.0"?>
<testset xmlns="http://cpee.org/ns/properties/2.0">
  <executionhandler>altrust</executionhandler>
  <dataelements>
    <station>0</station>
    <stations>3</stations>
    <park_t>30</park_t>
    <sample_i>0</sample_i>
    <samples>6</samples>
    <sample_interval>5</sample_interval>
    <qc_ok>true</qc_ok>
    <slot_t>10</slot_t>
  </dataelements>
  <endpoints>
    <user>https-post://cpee.org/services/timeout-user.php</user>
    <auto>https-post://cpee.org/services/timeout-auto.php</auto>
    <subprocess>https-post://cpee.org/flow/start/url/</subprocess>
    <timeout>https-post://cpee.org/services/timeout.php</timeout>
    <send>https-post://cpee.org/ing/correlators/message/send/</send>
    <receive>https-get://cpee.org/ing/correlators/message/receive/</receive>
    <announce>https-post://cpee.org/services/timeout.php</announce>
    <machine>https-post://cpee.org/services/timeout.php</machine>
    <sample>https-post://cpee.org/services/timeout.php</sample>
    <report>https-post://cpee.org/services/timeout.php</report>
    <slot_wait>https-post://cpee.org/services/timeout.php</slot_wait>
  </endpoints>
  <attributes>
    <info>bench_highload_cell</info>
    <creator>Christine Ashcreek</creator>
    <author>Christine Ashcreek</author>
    <modeltype>CPEE</modeltype>
    <guarded>none</guarded>
    <guarded_id/>
    <model_uuid>9114b86a-c9dd-4365-b4f2-4c6faa6b1def</model_uuid>
    <model_version/>
    <theme>extended</theme>
    <design_dir>Theses.dir/Carlo Deutschmann.dir</design_dir>
    <design_stage>development</design_stage>
    <executionhandler>altrust</executionhandler>
  </attributes>
  <description>
    <description xmlns="http://cpee.org/ns/description/1.0">
      <loop eid="e1" mode="pre_test" condition="data.station &lt; data.stations">
        <_probability>
          <_probability_min/>
          <_probability_max/>
          <_probability_avg/>
        </_probability>
        <_annotations>
          <_generic/>
          <_logging_behavior>
            <_iteration>false</_iteration>
          </_logging_behavior>
        </_annotations>
        <call id="a1" endpoint="announce">
          <parameters>
            <label>Auftrag anmelden</label>
            <color/>
            <arguments>
              <timeout>1</timeout>
            </arguments>
          </parameters>
          <annotations>
            <_generic/>
            <_logging_behavior>
              <_exclude>false</_exclude>
              <_include>false</_include>
            </_logging_behavior>
            <_timing>
              <_timing_weight/>
              <_timing_avg/>
              <explanations/>
            </_timing>
            <_shifting>
              <_shifting_type>Duration</_shifting_type>
            </_shifting>
            <_context_data_analysis>
              <probes/>
              <ips/>
            </_context_data_analysis>
            <report>
              <url/>
            </report>
            <_notes>
              <_notes_general/>
            </_notes>
          </annotations>
          <documentation>
            <input/>
            <output/>
            <implementation>
              <description/>
            </implementation>
          </documentation>
        </call>
        <call id="a2" endpoint="slot_wait">
          <parameters>
            <label>auf Maschine warten</label>
            <color/>
            <arguments>
              <timeout>!data.slot_t</timeout>
            </arguments>
          </parameters>
          <annotations>
            <_generic/>
            <_logging_behavior>
              <_exclude>false</_exclude>
              <_include>false</_include>
            </_logging_behavior>
            <_timing>
              <_timing_weight/>
              <_timing_avg/>
              <explanations/>
            </_timing>
            <_shifting>
              <_shifting_type>Duration</_shifting_type>
            </_shifting>
            <_context_data_analysis>
              <probes/>
              <ips/>
            </_context_data_analysis>
            <report>
              <url/>
            </report>
            <_notes>
              <_notes_general/>
            </_notes>
          </annotations>
          <documentation>
            <input/>
            <output/>
            <implementation>
              <description/>
            </implementation>
          </documentation>
        </call>
        <parallel eid="e2" wait="-1" cancel="last">
          <parallel_branch eid="e3">
            <call id="a3" endpoint="machine">
              <parameters>
                <label>Bearbeitung</label>
                <color/>
                <arguments>
                  <timeout>!data.park_t</timeout>
                </arguments>
              </parameters>
              <annotations>
                <_generic/>
                <_logging_behavior>
                  <_exclude>false</_exclude>
                  <_include>false</_include>
                </_logging_behavior>
                <_timing>
                  <_timing_weight/>
                  <_timing_avg/>
                  <explanations/>
                </_timing>
                <_shifting>
                  <_shifting_type>Duration</_shifting_type>
                </_shifting>
                <_context_data_analysis>
                  <probes/>
                  <ips/>
                </_context_data_analysis>
                <report>
                  <url/>
                </report>
                <_notes>
                  <_notes_general/>
                </_notes>
              </annotations>
              <documentation>
                <input/>
                <output/>
                <implementation>
                  <description/>
                </implementation>
              </documentation>
            </call>
          </parallel_branch>
          <loop eid="e5" mode="pre_test" condition="data.sample_i &lt; data.samples">
            <parallel_branch eid="e4">
              <call id="a4" endpoint="sample">
                <parameters>
                  <label>Messwert holen</label>
                  <color/>
                  <arguments>
                    <timeout>!data.sample_interval</timeout>
                  </arguments>
                </parameters>
                <annotations>
                  <_generic/>
                  <_logging_behavior>
                    <_exclude>false</_exclude>
                    <_include>false</_include>
                  </_logging_behavior>
                  <_timing>
                    <_timing_weight/>
                    <_timing_avg/>
                    <explanations/>
                  </_timing>
                  <_shifting>
                    <_shifting_type>Duration</_shifting_type>
                  </_shifting>
                  <_context_data_analysis>
                    <probes/>
                    <ips/>
                  </_context_data_analysis>
                  <report>
                    <url/>
                  </report>
                  <_notes>
                    <_notes_general/>
                  </_notes>
                </annotations>
                <documentation>
                  <input/>
                  <output/>
                  <implementation>
                    <description/>
                  </implementation>
                </documentation>
              </call>
            </parallel_branch>
            <manipulate id="a5" label="Messung verbuchen">
              <code>data.sample_i += 1</code>
              <annotations>
                <_logging_behavior>
                  <_exclude>false</_exclude>
                </_logging_behavior>
                <_context_data_analysis>
                  <probes/>
                </_context_data_analysis>
              </annotations>
            </manipulate>
            <_probability>
              <_probability_min/>
              <_probability_max/>
              <_probability_avg/>
            </_probability>
            <_annotations>
              <_generic/>
              <_logging_behavior>
                <_iteration>false</_iteration>
              </_logging_behavior>
            </_annotations>
          </loop>
        </parallel>
        <manipulate id="a6" label="QS Bewerten">
          <code>data.qc_ok = data.station.even?
data.sample_i = 0</code>
          <annotations>
            <_logging_behavior>
              <_exclude>false</_exclude>
            </_logging_behavior>
            <_context_data_analysis>
              <probes/>
            </_context_data_analysis>
          </annotations>
        </manipulate>
        <choose eid="e6" mode="exclusive" label="">
          <alternative eid="e7" condition="data.qc_ok">
            <call id="a7" endpoint="report">
              <parameters>
                <label>OK melden</label>
                <color/>
                <arguments>
                  <timeout>1</timeout>
                </arguments>
              </parameters>
              <annotations>
                <_generic/>
                <_logging_behavior>
                  <_exclude>false</_exclude>
                  <_include>false</_include>
                </_logging_behavior>
                <_timing>
                  <_timing_weight/>
                  <_timing_avg/>
                  <explanations/>
                </_timing>
                <_shifting>
                  <_shifting_type>Duration</_shifting_type>
                </_shifting>
                <_context_data_analysis>
                  <probes/>
                  <ips/>
                </_context_data_analysis>
                <report>
                  <url/>
                </report>
                <_notes>
                  <_notes_general/>
                </_notes>
              </annotations>
              <documentation>
                <input/>
                <output/>
                <implementation>
                  <description/>
                </implementation>
              </documentation>
            </call>
            <_probability>
              <_probability_min/>
              <_probability_max/>
              <_probability_avg/>
            </_probability>
          </alternative>
          <otherwise eid="e8">
            <call id="a8" endpoint="report">
              <parameters>
                <label>Ausschuss melden</label>
                <color/>
                <arguments>
                  <timeout>1</timeout>
                </arguments>
              </parameters>
              <annotations>
                <_generic/>
                <_logging_behavior>
                  <_exclude>false</_exclude>
                  <_include>false</_include>
                </_logging_behavior>
                <_timing>
                  <_timing_weight/>
                  <_timing_avg/>
                  <explanations/>
                </_timing>
                <_shifting>
                  <_shifting_type>Duration</_shifting_type>
                </_shifting>
                <_context_data_analysis>
                  <probes/>
                  <ips/>
                </_context_data_analysis>
                <report>
                  <url/>
                </report>
                <_notes>
                  <_notes_general/>
                </_notes>
              </annotations>
              <documentation>
                <input/>
                <output/>
                <implementation>
                  <description/>
                </implementation>
              </documentation>
            </call>
          </otherwise>
        </choose>
        <manipulate id="a9" label="Next">
          <code>data.station += 1</code>
          <annotations>
            <_logging_behavior>
              <_exclude>false</_exclude>
            </_logging_behavior>
            <_context_data_analysis>
              <probes/>
            </_context_data_analysis>
          </annotations>
        </manipulate>
      </loop>
    </description>
  </description>
  <transformation>
    <description type="copy"/>
    <dataelements type="none"/>
    <endpoints type="none"/>
  </transformation>
</testset>
